<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="MC_Base_Theme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/mc_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/mc_dark</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <item name="android:windowBackground">?colorOnBackground</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <item name="colorControlActivated">@color/mc_white</item>
        <item name="checkboxStyle">@style/Widget.App.CheckBox</item>
        <item name="colorPrimary">@color/mc_colorPrimary</item>
        <item name="colorOnBackground">@color/mc_dark</item>
        <item name="colorError">@color/mc_white</item>
        <item name="mc_bg">@color/mc_basic_light</item>
        <item name="mc_tick">@color/mc_basic_light</item>
        <item name="mc_track">@color/mc_basic_light</item>
        <item name="mc_center">@color/mc_basic_light</item>
    </style>

    <!-- Define the checkbox specific theme override -->
    <style name="Widget.App.CheckBox" parent="Widget.Material3.CompoundButton.CheckBox">
        <!-- This will tint the checkbox to white -->
        <item name="buttonTint">@color/mc_white</item>
    </style>
</resources>