<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="MC_Base_Theme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:windowBackground">?colorOnBackground</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <item name="colorControlActivated">@color/mc_dark</item>
        <item name="checkboxStyle">@style/Widget.App.CheckBox</item>
        <item name="colorPrimary">@color/mc_colorPrimary</item>
        <item name="colorOnBackground">@color/mc_white</item>
        <item name="colorError">@color/mc_dark</item>
        <item name="mc_bg">@color/mc_basic</item>
        <item name="mc_tick">@color/mc_basic</item>
        <item name="mc_track">@color/mc_basic</item>
        <item name="mc_center">@color/mc_basic</item>
        <item name="multiColorButtonStyle">@style/Widget.MultiColors.Button</item>
    </style>

    <style name="Widget.MultiColors.Button" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@android:color/transparent</item>
        <item name="cardElevation">0dp</item>
        <item name="cardPreventCornerOverlap">false</item>
        <item name="shapeAppearanceOverlay">@style/CircleShape</item>
        <item name="strokeColor">@color/mc_white</item>
        <item name="strokeWidth">1dp</item>
    </style>

